*.db
*.db-wal
*.db-shm
*.db.enc
plannr-safety-snapshot-*.json

# WhatsApp session / state — and every sibling (_old, _snapshot, _snapshot_dead, .state.json, _diag)
.wwebjs_auth*
.wwebjs_cache/

# logs — current AND rotated (plannr-startup.log, plannr-startup.log.1, backup.log, …)
*.log
*.log.*

# local tooling (per-machine editor/tooling settings — not shared)
.claude/settings.local.json

# misc
.DS_Store

.wwebjs_cache.bak/
PLANNR-AUDIT-LIVE.md

.spike*
*-spike.js

# Phase 8b — sync-public-modules.js's copies (source of truth stays at the project root; these are
# regenerated before every `cap sync`, never hand-edited).
/public/db.js
/public/repo.js
/public/db-engine.js
/public/node-builtins-browser-stub.js
/public/ledgers.js
/public/backup-format.js
/public/request-rules.js
/public/core/
/public/allowances.js
/public/node_modules/

# Capacitor Android — the native project itself is checked in (some of it is hand-editable), but its
# build outputs and local machine config are not.
/android/app/build/
/android/build/
/android/.gradle/
/android/.kotlin/
/android/local.properties
/android/capacitor-cordova-android-plugins/
# Android Studio project config — machine-specific (last-deployed device serial, JDK pin, absolute
# paths in workspace.xml). Studio regenerates it on first open; never check it in.
/android/.idea/
# `npx cap sync android` output — regenerated from public/ on every sync.
/android/app/src/main/assets/
/android/app/src/main/res/xml/config.xml

*.keystore
keystore.properties
# other signing keys and certificates, and per-environment .env files (review S9)
*.jks
*.p12
*.pem
.env.*
!.env.example
# BACKUPS and copies of a key or its properties file (a zipped or renamed key still signs updates).
# Kept specific: ordinary .zip and .bak files are not ignored.
*.pfx
*.keystore.*
*.jks.*
*.p12.*
*.pem.*
*key-backup*
*keystore-backup*
*keystore*.zip
*keystore*.7z
keystore*.properties
keystore.properties.*
# what the app exports or a phone pull brings back: plain JSON backups, CSV and PDF exports,
# compressed databases, the import's automatic snapshot (they hold ledger data)
plannr-backup-*.json
plannr-*.csv
plannr-overview-*.pdf
*.db.gz
auto-snapshot-before-import-*.json

